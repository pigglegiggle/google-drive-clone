# Generate a private .env with: python3 scripts/configure.py
POSTGRES_PASSWORD=replace-with-a-random-password
S3_ACCESS_KEY=drive-admin
S3_SECRET_KEY=replace-with-a-random-secret-of-at-least-16-characters
WEB_PORT=8090
S3_PORT=9000
S3_CONSOLE_PORT=9001
S3_PUBLIC_ENDPOINT=http://localhost:9000
BIND_ADDRESS=127.0.0.1
SECURE_COOKIES=false
