        <mxCell id="2" value="Resumable upload — from file to published version" style="whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=24;fontColor=#111111;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="0" y="12" width="1200" height="40" />
